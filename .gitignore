# 依赖与构建产物
node_modules/
# 官方要求：编译产物只放 Release 附件，不入库。
# ⚠️ 必须写成 `/main.js` `/styles.css`（前导斜杠 = 仅根目录）。
# 裸写 `styles.css` 会匹配任意层级，把源码 `src/styles.css`（110KB）也排除掉，
# 导致 Actions checkout 后找不到它、Release 附件缺失。
/main.js
/main.js.map
/styles.css

# 运行时与本机数据
data.json
*.log
.DS_Store

# 本机库路径（每台机器不同，不应提交）
.vault-deploy-target

# 内部设计稿/草稿类文件，不属于插件源码
*.xlsx
push-to-github.sh

# Release 说明生成物（由 scripts/build-notes.mjs 产出）
RELEASE_NOTES.md

# 临时排查产物（下划线开头的调试文件，如 curl -o _x.json）
_*.json
_*.cjs
_*.js
_*.html
